# Dominio público (OG absolutas y canonical). En preview:
# https://gabame.mirmiapps.com — al migrar a gabame.com, cambiar y rebuild.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# --- Correo de los formularios -------------------------------------------
# Si falta cualquiera de estas, los formularios responden 503 y la interfaz
# muestra el correo de respaldo en vez de fallar en silencio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GABAME Web <no-reply@gabame.com>"

# Destinos. Farmacovigilancia va SEPARADO del contacto comercial.
MAIL_TO_CONTACT=contacto@gabame.com
MAIL_TO_PV=farmacovigilancia@gabame.com

# --- Interruptores de despliegue (se leen en el build) --------------------
# Chips con el nombre de las marcas en la vitrina de áreas. Solo `true` activa.
NEXT_PUBLIC_SHOW_BRAND_NAMES=false
